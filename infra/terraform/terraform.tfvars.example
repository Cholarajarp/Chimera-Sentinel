# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it contains project-specific config.
#
#   cp infra/terraform/terraform.tfvars.example infra/terraform/terraform.tfvars

# ── Required ─────────────────────────────────────────────────────────────────
project_id = "chimera-sentinel"

# ── Optional (defaults are usually fine) ─────────────────────────────────────
region      = "us-east1"
environment = "prod"

# Set to 1 before a live demo to keep the hot path warm (costs approximately $5/month idle).
# Set to 0 when not actively demoing to minimize idle spend.
hot_path_min_instances = 1

# Fill after first deploy: e.g. https://sentinel-web-HASH.run.app
# The normal same-origin /api proxy does not require CORS; this permits direct browser API diagnostics.
web_url_override = ""

# ── Managed agent resources ───────────────────────────────────────────────────
# Fill these in AFTER running: bash infra/scripts/setup-managed-agents.sh
# The script will write infra/scripts/managed-resources.env with the correct values.

# Three Gemini models — each serves a specific role in the certification pipeline
gemini_model_ref       = "gemini-3.5-flash-lite"   # batch case evaluation (80 cases)
gemini_model_ref_agent = "gemini-3.5-flash"         # ADK agent orchestration / brain
gemini_model_ref_deep  = "gemini-3.1-pro"           # deep analysis / ambiguous cases

model_armor_template   = ""  # e.g. projects/YOUR_PROJECT/locations/us-central1/templates/ap-agent-armor-v1
agent_gateway_resource = ""  # e.g. projects/YOUR_PROJECT/locations/us-central1/gateways/ap-agent-gateway
memory_bank_resource   = ""  # e.g. projects/YOUR_PROJECT/locations/us-central1/ragCorpora/123456789

# ── Firebase web app config (public — safe to commit) ─────────────────────────
firebase_api_key              = "AIzaSyApjm0VdVcZyB8PZRBw99lv9MPx_m_EjTE"
firebase_auth_domain          = "chimera-sentinel.firebaseapp.com"
firebase_project_id           = "chimera-sentinel"
firebase_storage_bucket       = "chimera-sentinel.firebasestorage.app"
firebase_messaging_sender_id  = "817919872645"
firebase_app_id               = "1:817919872645:web:b6826cca35d257c7e3e3ec"
firebase_measurement_id       = "G-HP9JJWRTBS"
