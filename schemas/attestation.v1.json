{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.enterprise/schemas/attestation.v1.json",
  "title": "AttestationMetadata",
  "type": "object",
  "required": ["payload", "signature", "key_reference", "canonicalization_algorithm", "status"],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "schema_version",
        "tenant_id",
        "environment",
        "workflow_id",
        "candidate_revision_id",
        "agent_registry_resource",
        "agent_runtime_resource",
        "agent_identity",
        "model_ref",
        "policy_pack_id",
        "decision",
        "issued_at",
        "not_before",
        "expires_at",
        "issuer",
        "nonce"
      ]
    },
    "signature": { "type": "string" },
    "key_reference": {
      "type": "object",
      "required": ["key_resource", "key_version", "algorithm"]
    },
    "canonicalization_algorithm": { "type": "string", "enum": ["RFC8785"] },
    "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED"] }
  }
}
