# Chimera Sentinel — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# Leave blank locally — Cloud Run uses Workload Identity automatically
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Control Plane (Rust Axum) ─────────────────────────────────────────────────
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8080
SENTINEL_ENVIRONMENT=production
SENTINEL_DEFAULT_TENANT=00000000-0000-0000-0000-000000000001
# Env-var overrides for nested TOML config (SENTINEL_ prefix, __ for nesting)
SENTINEL_GOOGLE_CLOUD__USE_LIVE_SERVICES=true

# ── ADK Certifier (Python) ────────────────────────────────────────────────────
SENTINEL_ADK_HOST=0.0.0.0
SENTINEL_ADK_PORT=8081
# Gemini model on Vertex AI — use a released model name
GEMINI_MODEL_REF=gemini-3.5-flash-preview

# ── Mock ERP MCP (Rust) ───────────────────────────────────────────────────────
SENTINEL_ERP_MCP_ADDR=127.0.0.1:9090
# URL the ADK certifier uses to call the mock ERP
ERP_MCP_URL=http://localhost:9090

# ── Cloud KMS ─────────────────────────────────────────────────────────────────
KMS_KEY_RESOURCE=projects/YOUR_PROJECT/locations/global/keyRings/sentinel-ring/cryptoKeys/attestation-signer
KMS_KEY_VERSION=1

# ── Managed Agent Services (fill after running setup-managed-agents.sh) ───────
MODEL_ARMOR_TEMPLATE=projects/YOUR_PROJECT/locations/us-central1/templates/ap-agent-armor-v1
AGENT_GATEWAY_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/gateways/ap-agent-gateway
MEMORY_BANK_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/ragCorpora/YOUR_CORPUS_ID

# ── Web Console (Next.js) ─────────────────────────────────────────────────────
# For local dev — proxied via next.config.js rewrites so no CORS issues
NEXT_PUBLIC_API_URL=http://localhost:8080
# For production (set at docker build time via ARG NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_API_URL=https://sentinel-control-plane-HASH.run.app

# ── Service URLs (populated by terraform output after deploy) ─────────────────
# SENTINEL_API_URL=https://sentinel-control-plane-HASH.run.app
# ADK_CERTIFIER_URL=https://sentinel-adk-certifier-HASH.run.app
# WEB_URL=https://sentinel-web-HASH.run.app
